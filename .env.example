# Copy this file to .env.local for local development.
# Never commit real secrets or API keys.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-your-browser-restricted-google-maps-key"
# Optional: server-side key restricted to Routes API only.
GOOGLE_ROUTES_API_KEY="replace-with-your-server-side-routes-key"
# Optional public lead webhook protection.
PUBLIC_API_KEY="replace-with-a-random-webhook-key"

