// שי סחר CRM — Foundation Schema v3
// שכבה 1: פלטפורמה + Core CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════ ENUMS ═══════════════

enum Role {
  ADMIN
  MANAGER
  SALES_REP
  CUSTOMER_SERVICE
  DISPATCHER
  TECHNICIAN
  VIEWER
}

enum CustomerStatus {
  LEAD
  PROSPECT
  ACTIVE
  CHURNED
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  REFERRAL
  COLD_CALL
  WHATSAPP
  GMAIL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  TASK
  SYSTEM
}

enum FollowUpChannel {
  SYSTEM
  CALL
  WHATSAPP
  EMAIL
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
  CANCELLED
}

enum FollowUpResult {
  NO_ANSWER
  ANSWERED
  CALLBACK_REQUESTED
  NOT_INTERESTED
  OPTED_OUT
  INVALID_NUMBER
  CONVERTED
}

enum CalendarType {
  LEAD_SALES
  TECHNICIAN_SERVICE
  FILTER_REPLACEMENT
}

enum ServiceCallStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCallType {
  INSTALLATION
  FILTER_CHANGE
  REPAIR
  MAINTENANCE
  INSPECTION
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceTaskType {
  SERVICE
  INSTALLATION
  FILTER_REPLACEMENT
}

enum ServiceTaskStatus {
  OPEN
  SCHEDULED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING_APPROVAL
  APPROVED
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  PENDING_STOCK
  READY_FOR_INSTALLATION
  INSTALLATION_SCHEDULED
  INSTALLATION_COMPLETED
  RETURNED
}

enum OrderPaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CREDIT
  REFUNDED
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ProductKind {
  PRODUCT
  SERVICE
  BUNDLE
}

enum StockMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  CONSUMPTION
  RETURN
  TRANSFER
  ADJUSTMENT
  DAMAGE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ManufacturerWarrantyStatus {
  ACTIVE
  EXPIRED
  NONE
}

enum ServiceInsuranceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_RENEWAL
}

enum InsurancePaymentFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum TechnicianProfileStatus {
  ACTIVE
  UNAVAILABLE
  ON_LEAVE
  DISABLED
  LEFT
}

enum TechnicianAssignmentStatus {
  ASSIGNED
  CONFIRMED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

// ═══════════════ PLATFORM ═══════════════

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  passwordHash     String
  role             Role      @default(VIEWER)
  isActive         Boolean   @default(true)
  isBlocked        Boolean   @default(false)
  emailVerified    DateTime?
  emailVerifyToken String?
  inviteToken      String?
  inviteExpiresAt  DateTime?
  permissions      Json      @default("{}")
  managerId        String?
  manager          User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]    @relation("UserManager")
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs                    AuditLog[]
  assignedCustomers            Customer[]                @relation("CustomerAssignee")
  createdCustomers             Customer[]                @relation("CustomerCreator")
  assignedLeads                Lead[]                    @relation("LeadAssignee")
  assignedDeals                Deal[]                    @relation("DealAssignee")
  activities                   Activity[]
  serviceTechnicianCalls       ServiceCall[]             @relation("ServiceTechnician")
  technicianAppointments       Appointment[]             @relation("AppointmentTechnician")
  assignedTasks                Task[]                    @relation("TaskAssignee")
  assignedServiceTasks         ServiceTask[]             @relation("ServiceTaskTechnician")
  dashboardKpis                DashboardKpi[]
  quoteItemHistoryCreated      QuoteItemHistory[]        @relation("QuoteItemHistoryCreator")
  quoteVersionsCreated         QuoteVersion[]            @relation("QuoteVersionCreator")
  routePlans                   RoutePlan[]               @relation("RouteTechnician")
  serviceInsuranceRenewals     ServiceInsuranceRenewal[] @relation("InsuranceRenewalUser")
  assignedOrders               Order[]                   @relation("OrderAssignee")
  technicianOrders             Order[]                   @relation("OrderTechnician")
  technicianProfile            TechnicianProfile?
  createdTechnicianAssignments TechnicianAssignment[]    @relation("TechnicianAssignmentCreator")
  technicianStatusChanges      TechnicianStatusLog[]     @relation("TechnicianStatusChanger")
  orderStatusChanges           OrderStatusHistory[]      @relation("OrderStatusChangedBy")
  orderApprovals               OrderApproval[]           @relation("OrderApprovedBy")
  customRoleAssignments        UserRoleAssignment[]
  temporaryPermissions         TemporaryPermission[]     @relation("TemporaryPermissionUser")
  grantedTemporaryPermissions  TemporaryPermission[]     @relation("TemporaryPermissionGrantedBy")
  createdCustomRoles           CustomRole[]              @relation("CustomRoleCreatedBy")
  grantedRoleAssignments       UserRoleAssignment[]      @relation("UserRoleAssignmentGrantedBy")
  createdQuotes                Quote[]                   @relation("QuoteCreator")

  @@index([role])
  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ═══════════════ EXTENSIBLE ACCESS CONTROL ═══════════════
// תוספת תאימות לאחור: התפקיד וה-JSON הקיימים ב-User נשארים מקור ברירת המחדל.

model PermissionDefinition {
  id           String                 @id @default(cuid())
  key          String                 @unique
  description  String?
  category     String?
  isSensitive  Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  roleBindings CustomRolePermission[]
}

model CustomRole {
  id          String                 @id @default(cuid())
  name        String                 @unique
  description String?
  isSystem    Boolean                @default(false)
  isActive    Boolean                @default(true)
  createdById String?
  createdBy   User?                  @relation("CustomRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  permissions CustomRolePermission[]
  assignments UserRoleAssignment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model CustomRolePermission {
  customRoleId String
  permissionId String
  actions      Json                 @default("[]")
  scope        String               @default("ALL")
  conditions   Json?
  fieldRules   Json?
  customRole   CustomRole           @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([customRoleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  userId       String
  customRoleId String
  assignedById String?
  expiresAt    DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  assignedBy   User?      @relation("UserRoleAssignmentGrantedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, customRoleId])
  @@index([expiresAt])
}

model TemporaryPermission {
  id            String   @id @default(cuid())
  userId        String
  permissionKey String
  scope         String   @default("ALL")
  conditions    Json?
  startsAt      DateTime @default(now())
  endsAt        DateTime
  grantedById   String
  reason        String
  user          User     @relation("TemporaryPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy     User     @relation("TemporaryPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([userId, endsAt])
  @@index([permissionKey])
}

// ═══════════════ CORE CRM — CUSTOMER ═══════════════

model Customer {
  id                           String                     @id @default(cuid())
  name                         String
  company                      String?
  email                        String?
  phone                        String                     @unique
  address                      String?
  city                         String?
  lat                          Float?
  lng                          Float?
  status                       CustomerStatus             @default(LEAD)
  source                       LeadSource?
  confidence                   Confidence?
  notes                        String?
  taxId                        String?
  preferredLanguage            String?                    @default("he")
  communicationOptOut          Boolean                    @default(false)
  whatsappConsent              Boolean                    @default(false)
  whatsappPhone                String?
  serviceInsuranceEnabled      Boolean                    @default(false)
  serviceInsurancePlan         String?
  serviceInsuranceStartDate    DateTime?
  serviceInsuranceEndDate      DateTime?
  serviceInsuranceMonthlyPrice Float?
  serviceInsuranceFrequency    InsurancePaymentFrequency?
  serviceInsuranceStatus       ServiceInsuranceStatus     @default(ACTIVE)
  serviceInsuranceReminderDays Int                        @default(30)
  serviceInsuranceNotes        String?
  customData                   Json                       @default("{}")
  assignedToId                 String?
  assignedTo                   User?                      @relation("CustomerAssignee", fields: [assignedToId], references: [id])
  createdById                  String?
  createdBy                    User?                      @relation("CustomerCreator", fields: [createdById], references: [id])
  contacts                     CustomerContact[]
  leads                        Lead[]
  deals                        Deal[]
  activities                   Activity[]
  installedSystems             InstalledSystem[]
  serviceCalls                 ServiceCall[]
  appointments                 Appointment[]
  tasks                        Task[]
  serviceTasks                 ServiceTask[]
  orders                       Order[]
  routeStops                   RouteStop[]                @relation("RouteStopCustomer")
  serviceInsuranceRenewals     ServiceInsuranceRenewal[]
  quotes                       Quote[]
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  @@index([status])
  @@index([city])
  @@index([assignedToId])
  @@index([createdAt])
}

// ═══════════════ הצעות מחיר (Quotes) ═══════════════

model Quote {
  id                  String      @id @default(cuid())
  number              String      @unique
  customerId          String
  leadId              String?
  title               String
  status              QuoteStatus @default(DRAFT)
  version             Int         @default(1)
  parentQuoteId       String?
  subtotal            Float       @default(0)
  discountPercent     Float       @default(0)
  vatPercent          Float       @default(17)
  tax                 Float       @default(0)
  totalBeforeDiscount Float       @default(0)
  total               Float       @default(0)
  currency            String      @default("ILS")
  validUntil          DateTime?
  sentAt              DateTime?
  viewedAt            DateTime?
  notes               String?
  convertedOrderId    String?     @unique
  createdById         String?
  createdBy           User?       @relation("QuoteCreator", fields: [createdById], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead        Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parentQuote Quote?             @relation("QuoteVersions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  childQuotes Quote[]            @relation("QuoteVersions")
  items       QuoteItem[]
  itemHistory QuoteItemHistory[]
  snapshots   QuoteVersion[]

  @@index([customerId])
  @@index([status])
  @@index([leadId])
  @@index([parentQuoteId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  itemType    String  @default("PRODUCT")
  name        String?
  model       String?
  description String  @default("")
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  total       Float   @default(0)
  isOptional  Boolean @default(false)
  recommended Boolean @default(false)
  sortOrder   Int     @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}

model QuoteItemHistory {
  id           String   @id @default(cuid())
  quoteId      String
  itemId       String?
  changeType   String
  oldProductId String?
  newProductId String?
  oldModel     String?
  newModel     String?
  oldPrice     Float?
  newPrice     Float?
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy User? @relation("QuoteItemHistoryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([createdAt])
}

model QuoteVersion {
  id          String   @id @default(cuid())
  quoteId     String
  version     Int
  snapshot    Json
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy User? @relation("QuoteVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([quoteId, version])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}
// ═══════════════ CORE CRM — LEAD ═══════════════

model Lead {
  id                        String               @id @default(cuid())
  customerId                String?
  customer                  Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name                      String
  company                   String?
  email                     String?
  phone                     String?
  city                      String?
  source                    LeadSource           @default(WEBSITE)
  stage                     LeadStage            @default(NEW)
  confidence                Confidence           @default(MEDIUM)
  score                     Int?
  value                     Float?
  assignedToId              String?
  assignedTo                User?                @relation("LeadAssignee", fields: [assignedToId], references: [id])
  lostReason                String?
  expectedCloseDate         DateTime?
  notes                     String?
  noAnswerAttempt           Int                  @default(0)
  optedOut                  Boolean              @default(false)
  convertedAt               DateTime?
  convertedCustomerId       String?
  utmData                   Json                 @default("{}")
  interests                 Json                 @default("[]")
  orders                    Order[]              @relation("LeadOrders")
  currentSystem             String?
  quoteAmount               Float?
  quoteIncludesVat          Boolean              @default(true)
  quoteIncludesInstallation Boolean              @default(false)
  quoteSentAt               DateTime?
  quoteStatus               String?
  quoteId                   String?
  ordered                   Boolean              @default(false)
  quotes                    Quote[]
  followUps                 LeadFollowUp[]
  activities                LeadActivity[]
  contactAttempts           LeadContactAttempt[]
  calendarEvents            LeadCalendarEvent[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([stage])
  @@index([source])
  @@index([confidence])
  @@index([assignedToId])
  @@index([createdAt])
}

// ═══════════════ LEAD WORKSPACE ═══════════════

model LeadFollowUp {
  id            String          @id @default(cuid())
  leadId        String
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attemptNumber Int
  channel       FollowUpChannel
  scheduledAt   DateTime
  completedAt   DateTime?
  status        FollowUpStatus  @default(PENDING)
  result        FollowUpResult?
  templateKey   String?
  messageId     String?
  notes         String?
  assignedToId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([leadId, scheduledAt])
  @@index([status, scheduledAt])
}

model LeadActivity {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          String
  subject       String
  body          String
  outcome       String?
  channel       String?
  nextContactAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([leadId, createdAt])
}

model LeadContactAttempt {
  id            String          @id @default(cuid())
  leadId        String
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attemptNumber Int
  channel       FollowUpChannel
  attemptedAt   DateTime        @default(now())
  result        FollowUpResult?
  notes         String?
  nextContactAt DateTime?
  createdById   String?

  @@index([leadId, attemptedAt])
}

model LeadCalendarEvent {
  id           String       @id @default(cuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  type         CalendarType @default(LEAD_SALES)
  startAtUtc   DateTime
  endAtUtc     DateTime?
  timezone     String       @default("Asia/Jerusalem")
  status       String       @default("SCHEDULED")
  assignedToId String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([leadId, startAtUtc])
  @@index([type, startAtUtc])
}

// ═══════════════ CORE CRM — DEAL ═══════════════

model Deal {
  id                String     @id @default(cuid())
  title             String
  customerId        String
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  value             Float
  status            DealStatus @default(OPEN)
  stage             LeadStage  @default(NEW)
  probability       Int        @default(10)
  assignedToId      String?
  assignedTo        User?      @relation("DealAssignee", fields: [assignedToId], references: [id])
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([stage])
  @@index([customerId])
  @@index([assignedToId])
}

// ═══════════════ OPERATIONS ═══════════════

model InstalledSystem {
  id                               String                     @id @default(cuid())
  customerId                       String
  customer                         Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  systemType                       String
  model                            String
  serialNumber                     String?
  filterTypes                      Json                       @default("[]")
  installationDate                 DateTime?
  warrantyUntil                    DateTime?
  manufacturerWarrantyUntil        DateTime?
  manufacturerWarrantyStart        DateTime?
  manufacturerWarrantyStatus       ManufacturerWarrantyStatus @default(NONE)
  manufacturerWarrantyReminderDays Int                        @default(30)
  serviceCycleDays                 Int?
  nextFilterChangeDate             DateTime?
  technicianTips                   String?
  isActive                         Boolean                    @default(true)
  serviceCalls                     ServiceCall[]
  appointments                     Appointment[]
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt

  @@index([customerId])
  @@index([nextFilterChangeDate])
}

model ServiceInsuranceRenewal {
  id               String                    @id @default(cuid())
  customerId       String
  customer         Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime
  amount           Float
  frequency        InsurancePaymentFrequency
  paidAt           DateTime?
  paymentReference String?
  notes            String?
  createdById      String?
  createdBy        User?                     @relation("InsuranceRenewalUser", fields: [createdById], references: [id])
  createdAt        DateTime                  @default(now())

  @@index([customerId, endDate])
  @@index([paidAt])
}

model ServiceCall {
  id                    String                 @id @default(cuid())
  callNumber            String                 @unique
  customerId            String
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installedSystemId     String?
  installedSystem       InstalledSystem?       @relation(fields: [installedSystemId], references: [id])
  type                  ServiceCallType        @default(MAINTENANCE)
  status                ServiceCallStatus      @default(OPEN)
  fault                 String?
  description           String?
  treatmentNotes        String?
  notes                 String?
  cost                  Float?
  technicianId          String?
  technician            User?                  @relation("ServiceTechnician", fields: [technicianId], references: [id])
  scheduledAt           DateTime?
  openedAt              DateTime               @default(now())
  completedAt           DateTime?
  nextContactAt         DateTime?
  partsUsed             Json                   @default("[]")
  inspectionChecklist   Json                   @default("{}")
  technicianAssignments TechnicianAssignment[]
  beforePhotos          Json                   @default("[]")
  afterPhotos           Json                   @default("[]")
  signatureDataUrl      String?
  pressureReading       String?
  leakCheck             Boolean?
  customerSignatureUrl  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([customerId, scheduledAt])
  @@index([status, scheduledAt])
}

model Appointment {
  id                String           @id @default(cuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installedSystemId String?
  installedSystem   InstalledSystem? @relation(fields: [installedSystemId], references: [id])
  type              CalendarType     @default(TECHNICIAN_SERVICE)
  title             String
  startAtUtc        DateTime
  endAtUtc          DateTime?
  timezone          String           @default("Asia/Jerusalem")
  status            String           @default("SCHEDULED")
  technicianId      String?
  technician        User?            @relation("AppointmentTechnician", fields: [technicianId], references: [id])
  notes             String?
  order             Order?           @relation(fields: [orderId], references: [id])
  orderId           String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerId, startAtUtc])
  @@index([type, startAtUtc])
}

model Task {
  id           String       @id @default(cuid())
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, dueAt])
  @@index([assignedToId])
}

model ServiceTask {
  id                   String            @id @default(cuid())
  customerId           String
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type                 ServiceTaskType
  status               ServiceTaskStatus @default(OPEN)
  productType          String?
  region               String?
  technicianId         String?
  technician           User?             @relation("ServiceTaskTechnician", fields: [technicianId], references: [id])
  manualTechnicianName String?
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  executionNotes       String?
  partsReplaced        Json              @default("[]")
  nextServiceDueDate   DateTime?
  sourceId             String?
  sourceType           String?
  title                String
  addressSnapshot      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  completedAt          DateTime?

  @@index([status, scheduledStart])
  @@index([type, status])
  @@index([technicianId, scheduledStart])
  @@index([customerId, createdAt])
  @@index([nextServiceDueDate])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId              String?
  lead                Lead?                @relation("LeadOrders", fields: [leadId], references: [id], onDelete: SetNull)
  title               String
  status              OrderStatus          @default(DRAFT)
  subtotal            Float                @default(0)
  vatRate             Float                @default(18)
  vatAmount           Float                @default(0)
  total               Float                @default(0)
  discount            Float                @default(0)
  paymentStatus       String               @default("PENDING")
  paymentMethod       String?
  scheduledAt         DateTime?
  deliveryDate        DateTime?
  appointment         Appointment?
  items               OrderItem[]
  notes               String?
  source              String?
  assignedToId        String?
  assignedTo          User?                @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  technicianId        String?
  technician          User?                @relation("OrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  deliveryAddress     String?
  installationAddress String?
  internalNotes       String?
  customerNotes       String?
  approvedAt          DateTime?
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  attachments         OrderAttachment[]
  shipments           OrderShipment[]
  approvals           OrderApproval[]
  returns             ReturnRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([leadId])
  @@index([assignedToId])
  @@index([technicianId])
  @@index([createdAt])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name                 String
  productId            String?
  product              Product? @relation(fields: [productId], references: [id])
  sku                  String?
  quantity             Int      @default(1)
  unitPrice            Float    @default(0)
  discount             Float    @default(0)
  vatRate              Float    @default(0.17)
  stockStatus          String   @default("NOT_APPLICABLE")
  requiresInstallation Boolean  @default(false)
  requiresTechnician   Boolean  @default(false)
  warehouseId          String?
  lineTotal            Float    @default(0)
  createdAt            DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   User?        @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Float
  status            OrderPaymentStatus @default(PENDING)
  method            String?
  externalReference String?
  lastFour          String?
  paidAt            DateTime?
  nextChargeAt      DateTime?
  accountingNotes   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([orderId, createdAt])
}

model OrderAttachment {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderShipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId, status])
}

model OrderApproval {
  id            String              @id @default(cuid())
  orderId       String
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        OrderApprovalStatus @default(PENDING)
  requestedById String?
  approvedById  String?
  approvedBy    User?               @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  note          String?
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@index([orderId, status])
}

model ReturnRequest {
  id           String              @id @default(cuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       ReturnRequestStatus @default(REQUESTED)
  reason       String
  refundAmount Float?
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([orderId, status])
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
}

model Product {
  id                  String                @id @default(cuid())
  name                String
  sku                 String                @unique
  description         String?
  barcode             String?               @unique
  imageUrl            String?
  kind                ProductKind           @default(PRODUCT)
  categoryId          String?
  category            ProductCategory?      @relation(fields: [categoryId], references: [id])
  unit                String                @default("יחידה")
  costPrice           Float                 @default(0)
  salePrice           Float                 @default(0)
  vatRate             Float                 @default(0.17)
  trackStock          Boolean               @default(true)
  reorderPoint        Int                   @default(0)
  reorderQuantity     Int                   @default(0)
  isActive            Boolean               @default(true)
  isConsumable        Boolean               @default(true)
  supplierId          String?
  orderItems          OrderItem[]
  inventoryItems      InventoryItem[]
  movements           StockMovement[]
  purchaseItems       PurchaseOrderItem[]
  technicianInventory TechnicianInventory[]
  quoteItems          QuoteItem[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([categoryId])
  @@index([kind, isActive])
}

model Warehouse {
  id          String          @id @default(cuid())
  name        String
  address     String?
  phone       String?
  managerName String?
  isActive    Boolean         @default(true)
  inventory   InventoryItem[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
}

model InventoryItem {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantityOnHand   Int       @default(0)
  quantityReserved Int       @default(0)
  reorderPoint     Int       @default(0)
  reorderQuantity  Int       @default(0)
  updatedAt        DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  type           StockMovementType
  quantity       Int
  reference      String?
  note           String?
  quantityBefore Int?
  quantityAfter  Int?
  unitCost       Float?
  orderId        String?
  serviceCallId  String?
  technicianId   String?
  createdById    String?
  createdAt      DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  purchaseNumber String              @unique
  supplierName   String
  status         PurchaseOrderStatus @default(DRAFT)
  expectedAt     DateTime?
  total          Float               @default(0)
  notes          String?
  items          PurchaseOrderItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Float         @default(0)
}

// ═══════════════ INTEGRATION HUB ═══════════════

model Integration {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  category      String
  status        String    @default("DISCONNECTED")
  enabled       Boolean   @default(false)
  config        Json      @default("{}")
  lastCheckedAt DateTime?
  lastError     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  webhooks      WebhookEndpoint[]
  events        IntegrationEvent[]
  mappings      FieldMapping[]
  emailProfiles EmailMappingProfile[]

  @@index([category])
  @@index([status])
}

model EmailMappingProfile {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  name          String
  matchType     String      @default("DOMAIN")
  matchValue    String
  mapping       Json        @default("{}")
  enabled       Boolean     @default(true)
  priority      Int         @default(0)
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, matchType, matchValue])
  @@index([integrationId, enabled, priority])
}

model WebhookEndpoint {
  id             String      @id @default(cuid())
  integrationId  String
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  name           String
  secretHash     String?
  targetModule   String
  fieldMapping   Json        @default("{}")
  isActive       Boolean     @default(true)
  lastReceivedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  events IntegrationEvent[]

  @@index([integrationId])
  @@index([isActive])
}

model FieldMapping {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  sourceField   String
  targetField   String
  transform     String?
  defaultValue  String?
  required      Boolean     @default(false)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, sourceField, targetField])
  @@index([integrationId])
}

model IntegrationEvent {
  id              String           @id @default(cuid())
  integrationId   String
  integration     Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  webhookId       String?
  webhook         WebhookEndpoint? @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  direction       String           @default("INBOUND")
  eventType       String
  idempotencyKey  String?
  status          String           @default("RECEIVED")
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  retryCount      Int              @default(0)
  receivedAt      DateTime         @default(now())
  processedAt     DateTime?

  @@unique([integrationId, idempotencyKey])
  @@index([integrationId, receivedAt])
  @@index([status])
}

// Secure integration operations, outbound webhooks and retry queue.
model IntegrationConnection {
  id                 String    @id @default(cuid())
  provider           String
  name               String
  status             String    @default("DISCONNECTED")
  mode               String    @default("SANDBOX")
  encryptedConfig    String
  lastHealthCheckAt  DateTime?
  lastError          String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([provider])
  @@index([status])
}

model ExternalEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  payloadHash     String
  eventType       String
  payload         Json
  status          String    @default("RECEIVED")
  errorMessage    String?
  attempts        Int       @default(0)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([status])
  @@index([eventType])
}

model IntegrationJob {
  id            String   @id @default(cuid())
  provider      String
  jobType       String
  payload       Json
  status        String   @default("RECEIVED")
  attempts      Int      @default(0)
  maxAttempts   Int      @default(4)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([provider])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  lastFour    String
  permissions Json      @default("[]")
  ipAllowlist Json      @default("[]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([revokedAt])
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  name        String
  url         String
  events      Json     @default("[]")
  secretHash  String
  isActive    Boolean  @default(true)
  attempts    Int      @default(0)
  lastStatus  String?
  lastError   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model IntegrationHealthCheck {
  id         String   @id @default(cuid())
  provider   String
  status     String
  responseMs Int?
  message    String?
  checkedAt  DateTime @default(now())

  @@index([provider, checkedAt])
}

model DashboardKpi {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  source     String
  metric     String
  period     String   @default("month")
  filterJson Json     @default("{}")
  target     Float?
  color      String   @default("#3d8bfd")
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, position])
  @@index([isActive])
}

model Activity {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      String?
  type        ActivityType
  subject     String
  description String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ═══════════════ AUTOMATION ENGINE ═══════════════

model Automation {
  id             String    @id @default(cuid())
  name           String
  description    String?
  module         String
  status         String    @default("DRAFT")
  version        Int       @default(1)
  trigger        Json
  conditions     Json      @default("[]")
  actions        Json      @default("[]")
  approvalPolicy Json      @default("{}")
  safetyPolicy   Json      @default("{}")
  enabled        Boolean   @default(false)
  createdById    String?
  updatedById    String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions AutomationVersion[]
  runs     AutomationRun[]

  @@index([module, status])
  @@index([enabled])
}

model AutomationVersion {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  createdById  String?
  createdAt    DateTime   @default(now())

  @@unique([automationId, version])
  @@index([automationId])
}

model AutomationRun {
  id             String     @id @default(cuid())
  automationId   String
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  entityType     String?
  entityId       String?
  idempotencyKey String     @unique
  status         String     @default("RUNNING")
  triggerData    Json       @default("{}")
  actionsResult  Json       @default("[]")
  attempts       Int        @default(0)
  errorMessage   String?
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?

  @@index([automationId, startedAt])
  @@index([status])
  @@index([entityType, entityId])
}

model ApprovalRequest {
  id              String    @id @default(cuid())
  automationId    String?
  automationRunId String?
  entity          String
  entityId        String
  action          String
  status          String    @default("PENDING")
  requestedById   String?
  approvedById    String?
  reason          String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([entity, entityId])
}

model RoutePlan {
  id           String      @id @default(cuid())
  name         String
  serviceDate  DateTime
  technicianId String?
  technician   User?       @relation("RouteTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  status       String      @default("DRAFT")
  notes        String?
  stops        RouteStop[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([serviceDate])
  @@index([technicianId])
  @@index([status])
}

model RouteStop {
  id          String    @id @default(cuid())
  routePlanId String
  routePlan   RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  sequence    Int
  itemType    String
  itemId      String
  title       String
  customerId  String?
  customer    Customer? @relation("RouteStopCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  address     String?
  city        String?
  lat         Float
  lng         Float
  scheduledAt DateTime?
  durationMin Int       @default(60)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([routePlanId, sequence])
  @@index([customerId])
}

// Inventory & service catalog extensions
model Supplier {
  id           String   @id @default(cuid())
  name         String
  taxId        String?
  phone        String?
  email        String?
  address      String?
  contactName  String?
  paymentTerms String?
  leadTimeDays Int?
  rating       Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

model ServiceCatalogItem {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  description      String?
  basePrice        Float                @default(0)
  estimatedMinutes Int?
  laborCost        Float                @default(0)
  warrantyDays     Int?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  parts            ServiceCatalogPart[]

  @@index([isActive])
}

model ServiceCatalogPart {
  id              String             @id @default(cuid())
  serviceId       String
  inventoryItemId String
  defaultQuantity Int                @default(1)
  service         ServiceCatalogItem @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, inventoryItemId])
}

model StockReservation {
  id            String    @id @default(cuid())
  productId     String
  warehouseId   String
  orderId       String?
  serviceCallId String?
  quantity      Int
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  releasedAt    DateTime?

  @@index([productId, warehouseId, status])
}

model TechnicianProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNumber     String?                 @unique
  phone              String?
  profileImageUrl    String?
  identityNumber     String?
  status             TechnicianProfileStatus @default(ACTIVE)
  baseAddress        String?
  baseCity           String?
  baseRegion         String?
  baseLat            Float?
  baseLng            Float?
  serviceRadiusKm    Float?
  preferredAreas     Json                    @default("[]")
  unavailableAreas   Json                    @default("[]")
  teamName           String?
  managerId          String?
  startedAt          DateTime?
  employmentType     String?
  notes              String?
  maxCallsPerDay     Int?
  emergencyAvailable Boolean                 @default(false)
  skills             TechnicianSkill[]
  serviceAreas       TechnicianServiceArea[]
  availability       TechnicianAvailability[]
  locations          TechnicianLocation[]
  assignments        TechnicianAssignment[]  @relation("TechnicianAssignmentAssignee")
  statusHistory      TechnicianStatusLog[]
  inventory          TechnicianInventory[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([status])
  @@index([baseCity, baseRegion])
}

model TechnicianSkill {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill        String
  level        String            @default("STANDARD")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([technicianId, skill])
  @@index([skill, isActive])
}

model TechnicianServiceArea {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  city         String?
  region       String?
  radiusKm     Float?
  isActive     Boolean           @default(true)

  @@index([technicianId])
  @@index([city, region])
}

model TechnicianAvailability {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  breakStart   String?
  breakEnd     String?
  isAvailable  Boolean           @default(true)

  @@unique([technicianId, dayOfWeek])
}

model TechnicianLocation {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracy     Float?
  source       String            @default("GPS")
  recordedAt   DateTime          @default(now())

  @@index([technicianId, recordedAt])
}

model TechnicianAssignment {
  id            String                     @id @default(cuid())
  serviceCallId String
  serviceCall   ServiceCall                @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  technicianId  String
  technician    TechnicianProfile          @relation("TechnicianAssignmentAssignee", fields: [technicianId], references: [id], onDelete: Cascade)
  assignedById  String?
  assignedBy    User?                      @relation("TechnicianAssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt    DateTime                   @default(now())
  status        TechnicianAssignmentStatus @default(ASSIGNED)
  notes         String?

  @@unique([serviceCallId, technicianId])
  @@index([technicianId, status])
}

model TechnicianStatusLog {
  id          String                   @id @default(cuid())
  technicianId String
  technician  TechnicianProfile        @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  oldStatus   TechnicianProfileStatus?
  newStatus   TechnicianProfileStatus
  changedById String?
  changedBy   User?                    @relation("TechnicianStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime                 @default(now())

  @@index([technicianId, createdAt])
}

model TechnicianInventory {
  id               String            @id @default(cuid())
  technicianId     String
  technician       TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int               @default(0)
  reservedQuantity Int               @default(0)
  updatedAt        DateTime          @updatedAt

  @@unique([technicianId, productId])
  @@index([productId])
}









