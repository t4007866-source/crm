// שי סחר CRM — Foundation Schema v3
// שכבה 1: פלטפורמה + Core CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════ ENUMS ═══════════════

enum Role {
  ADMIN
  MANAGER
  SALES_REP
  CUSTOMER_SERVICE
  DISPATCHER
  TECHNICIAN
  VIEWER
}

enum CustomerStatus {
  LEAD
  PROSPECT
  ACTIVE
  CHURNED
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  REFERRAL
  COLD_CALL
  WHATSAPP
  GMAIL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  TASK
  SYSTEM
}

enum FollowUpChannel {
  SYSTEM
  CALL
  WHATSAPP
  EMAIL
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
  CANCELLED
}

enum FollowUpResult {
  NO_ANSWER
  ANSWERED
  CALLBACK_REQUESTED
  NOT_INTERESTED
  OPTED_OUT
  INVALID_NUMBER
  CONVERTED
}

enum CalendarType {
  LEAD_SALES
  TECHNICIAN_SERVICE
  FILTER_REPLACEMENT
}

enum ServiceCallStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCallType {
  INSTALLATION
  FILTER_CHANGE
  REPAIR
  MAINTENANCE
  INSPECTION
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ═══════════════ PLATFORM ═══════════════

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  passwordHash     String
  role             Role      @default(VIEWER)
  isActive         Boolean   @default(true)
  isBlocked        Boolean   @default(false)
  emailVerified    DateTime?
  emailVerifyToken String?
  permissions      Json      @default("{}")
  managerId        String?
  manager          User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]    @relation("UserManager")
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs         AuditLog[]
  assignedCustomers Customer[] @relation("CustomerAssignee")
  createdCustomers  Customer[] @relation("CustomerCreator")
  assignedLeads     Lead[]      @relation("LeadAssignee")
  assignedDeals     Deal[]      @relation("DealAssignee")
  activities        Activity[]
  serviceTechnicianCalls ServiceCall[] @relation("ServiceTechnician")
  technicianAppointments Appointment[] @relation("AppointmentTechnician")
  assignedTasks     Task[] @relation("TaskAssignee")

  @@index([role])
  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ═══════════════ CORE CRM — CUSTOMER ═══════════════

model Customer {
  id           String         @id @default(cuid())
  name         String
  company      String?
  email        String?
  phone        String         @unique
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  status       CustomerStatus @default(LEAD)
  source       LeadSource?
  confidence   Confidence?
  notes        String?
  taxId        String?
  preferredLanguage String? @default("he")
  communicationOptOut Boolean @default(false)
  whatsappConsent Boolean @default(false)
  whatsappPhone String?
  customData   Json @default("{}")
  assignedToId String?
  assignedTo   User?          @relation("CustomerAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?          @relation("CustomerCreator", fields: [createdById], references: [id])
  contacts     CustomerContact[]
  leads        Lead[]
  deals        Deal[]
  activities   Activity[]
  installedSystems InstalledSystem[]
  serviceCalls ServiceCall[]
  appointments Appointment[]
  tasks        Task[]
  orders       Order[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([city])
  @@index([assignedToId])
  @@index([createdAt])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// ═══════════════ CORE CRM — LEAD ═══════════════

model Lead {
  id                String     @id @default(cuid())
  customerId        String?
  customer          Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name              String
  company           String?
  email             String?
  phone             String?
  city              String?
  source            LeadSource @default(WEBSITE)
  stage             LeadStage  @default(NEW)
  confidence        Confidence @default(MEDIUM)
  score             Int?
  value             Float?
  assignedToId      String?
  assignedTo        User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  lostReason        String?
  expectedCloseDate DateTime?
  notes             String?
  noAnswerAttempt   Int        @default(0)
  optedOut          Boolean    @default(false)
  convertedAt       DateTime?
  convertedCustomerId String?
  utmData           Json       @default("{}")
  interests         Json       @default("[]")
  currentSystem     String?
  quoteIncludesVat  Boolean    @default(true)
  quoteIncludesInstallation Boolean @default(false)
  ordered           Boolean    @default(false)
  followUps         LeadFollowUp[]
  activities        LeadActivity[]
  contactAttempts   LeadContactAttempt[]
  calendarEvents    LeadCalendarEvent[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([stage])
  @@index([source])
  @@index([confidence])
  @@index([assignedToId])
  @@index([createdAt])
}

// ═══════════════ LEAD WORKSPACE ═══════════════

model LeadFollowUp {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attemptNumber Int
  channel       FollowUpChannel
  scheduledAt   DateTime
  completedAt   DateTime?
  status        FollowUpStatus @default(PENDING)
  result        FollowUpResult?
  templateKey   String?
  messageId     String?
  notes         String?
  assignedToId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([leadId, scheduledAt])
  @@index([status, scheduledAt])
}

model LeadActivity {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          String
  subject       String
  body          String
  outcome       String?
  channel       String?
  nextContactAt DateTime?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadContactAttempt {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attemptNumber Int
  channel       FollowUpChannel
  attemptedAt   DateTime       @default(now())
  result        FollowUpResult?
  notes         String?
  nextContactAt DateTime?
  createdById   String?

  @@index([leadId, attemptedAt])
}

model LeadCalendarEvent {
  id           String       @id @default(cuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  type         CalendarType @default(LEAD_SALES)
  startAtUtc   DateTime
  endAtUtc     DateTime?
  timezone     String       @default("Asia/Jerusalem")
  status       String       @default("SCHEDULED")
  assignedToId String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([leadId, startAtUtc])
  @@index([type, startAtUtc])
}

// ═══════════════ CORE CRM — DEAL ═══════════════

model Deal {
  id                String     @id @default(cuid())
  title             String
  customerId        String
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  value             Float
  status            DealStatus @default(OPEN)
  stage             LeadStage  @default(NEW)
  probability       Int        @default(10)
  assignedToId      String?
  assignedTo        User?      @relation("DealAssignee", fields: [assignedToId], references: [id])
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([stage])
  @@index([customerId])
  @@index([assignedToId])
}

// ═══════════════ OPERATIONS ═══════════════

model InstalledSystem {
  id                   String   @id @default(cuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  systemType           String
  model                String
  serialNumber         String?
  filterTypes          Json     @default("[]")
  installationDate     DateTime?
  warrantyUntil        DateTime?
  serviceCycleDays     Int?
  nextFilterChangeDate DateTime?
  technicianTips       String?
  isActive             Boolean  @default(true)
  serviceCalls         ServiceCall[]
  appointments         Appointment[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([customerId])
  @@index([nextFilterChangeDate])
}

model ServiceCall {
  id             String            @id @default(cuid())
  callNumber     String            @unique
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installedSystemId String?
  installedSystem InstalledSystem? @relation(fields: [installedSystemId], references: [id])
  type           ServiceCallType   @default(MAINTENANCE)
  status         ServiceCallStatus @default(OPEN)
  fault          String?
  treatmentNotes String?
  technicianId   String?
  technician     User?             @relation("ServiceTechnician", fields: [technicianId], references: [id])
  scheduledAt    DateTime?
  openedAt       DateTime          @default(now())
  completedAt    DateTime?
  nextContactAt  DateTime?
  partsUsed      Json              @default("[]")
  customerSignatureUrl String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([customerId, scheduledAt])
  @@index([status, scheduledAt])
}

model Appointment {
  id             String          @id @default(cuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installedSystemId String?
  installedSystem InstalledSystem? @relation(fields: [installedSystemId], references: [id])
  type           CalendarType    @default(TECHNICIAN_SERVICE)
  title          String
  startAtUtc     DateTime
  endAtUtc       DateTime?
  timezone       String          @default("Asia/Jerusalem")
  status         String          @default("SCHEDULED")
  technicianId   String?
  technician     User?           @relation("AppointmentTechnician", fields: [technicianId], references: [id])
  notes          String?
  order          Order?          @relation(fields: [orderId], references: [id])
  orderId        String? @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([customerId, startAtUtc])
  @@index([type, startAtUtc])
}

model Task {
  id           String       @id @default(cuid())
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, dueAt])
  @@index([assignedToId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  status      OrderStatus @default(DRAFT)
  total       Float       @default(0)
  scheduledAt DateTime?
  appointment Appointment?
  items       OrderItem[]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
}
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  vatRate     Float    @default(0.17)
  stockStatus String   @default("NOT_APPLICABLE")
  createdAt   DateTime @default(now())

  @@index([orderId])
}


model Activity {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      String?
  type        ActivityType
  subject     String
  description String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

















