# שי סחר CRM — משתני סביבה
# העתק קובץ זה ל-.env ומלא את הערכים

# כתובת חיבור PostgreSQL — העתק מ-Neon / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shisachar?sslmode=require"

# סוד NextAuth — צור עם: openssl rand -base64 32
NEXTAUTH_SECRET="SHISACHAR-CHANGE-ME-use-openssl-rand"

# כתובת האתר בפיתוח
NEXTAUTH_URL="http://localhost:3000"

# Google Maps (אופציונלי — נדרש רק למפת השירות)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="הדבק-כאן-מפתח-Google-Maps"


